# Copy to .env and fill in. Never commit .env.

PORT=8787
# Comma-separated browser origins allowed to call this API (add your deployed frontend URL)
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# local | baseSepolia
CHAIN=local
# Leave empty to use the default RPC for the chain
RPC_URL=

# Deployed DonationTrail address
CONTRACT_ADDRESS=

# Private key of the verifier wallet (the address passed to the contract constructor).
# Use a throwaway wallet that holds only testnet ETH.
VERIFIER_PRIVATE_KEY=

# Leave empty to run in mock mode (amount must be supplied by the uploader for demos).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
