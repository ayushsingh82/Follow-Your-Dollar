# Copy to .env and fill in. Never commit .env.
# The network (Base Sepolia, chain id 84532), its RPC and the deployed contract address are built into
# shared/network.json, so none of them are needed here.

PORT=8787
# Comma-separated browser origins allowed to call this API (add your deployed frontend URL)
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Private key of the verifier wallet (0xB7D8...4aB40 on the deployed contract).
# Use a throwaway wallet that holds only testnet ETH.
VERIFIER_PRIVATE_KEY=

# Leave empty to run in demo mode (the uploader types the receipt total).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
